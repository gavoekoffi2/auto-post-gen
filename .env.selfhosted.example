# Pro Social AI — production environment, names and safe placeholders ONLY.
#
#   cp .env.selfhosted.example .env.selfhosted
#   $EDITOR .env.selfhosted
#   docker compose -f deploy/docker-compose.vps.yml --env-file .env.selfhosted up -d
#
# .env.selfhosted itself is git-ignored and must never be committed. Every
# value below is a placeholder: none of them is a real credential, and none
# will work as-is.
#
# Nothing here reaches the browser. The dashboard has no build-time
# configuration at all — it calls /api on its own origin — so a provider key
# in this file stays on the server by construction.

# =============================================================================
# REQUIRED — the stack does not start, or does not start SAFELY, without these
# =============================================================================
#   POSTGRES_USER / POSTGRES_PASSWORD / POSTGRES_DB   the database and its owner
#   SESSION_COOKIE_SECRET                             >= 32 chars; the API exits without it
#   APP_PUBLIC_URL                                    absolute origin used in email links
#   PUBLIC_HOSTNAME                                   the Host rule Traefik routes on
#   (DATABASE_URL is NOT set here: Compose composes it from the three
#    POSTGRES_* values, so the password lives in exactly one place. Set
#    DATABASE_URL directly only when running the API outside Compose.)
#
# OPTIONAL — each missing key disables exactly one capability, and the API says
# so at boot and again at the point of use. None of them blocks a deployment:
#   OPENROUTER_API_KEY .......... text generation
#   GRAPHISTE_GPT_API_KEY + GRAPHISTE_GPT_API_URL (both, or neither) ... posters
#   ZERNIO_API_KEY .............. social publishing
#   RESEND_API_KEY + RESEND_FROM  outbound email (password reset, validation)
#   CONTACT_TO .................. where the contact form AND "payment to verify"
#                                 alerts are delivered (defaults to RESEND_FROM)
#   CRON_SECRET ................. enables the scheduled endpoints (404 while unset)
#   PAYMENT_WAVE / PAYMENT_ORANGE_MONEY / PAYMENT_MTN_MOMO / PAYMENT_MOOV_MONEY
#   + PAYMENT_BENEFICIARY ....... where customers pay their subscription; with
#                                 none set, /abonnement asks them to write in
#
# WHO FILLS THEM IN: Hermes, on the VPS, in .env.selfhosted — which is
# git-ignored. No real value is ever committed to this repository, and Claude
# neither knows nor asks for any of them.
# =============================================================================

# --- Identity of the stack --------------------------------------------------
# Used as the Compose project name and as the prefix Docker applies to
# anything not named explicitly.
COMPOSE_PROJECT_NAME=pro-social-ai

# Container names. Set these to whatever the VPS already uses, so an existing
# install is updated rather than duplicated alongside it.
POSTGRES_CONTAINER_NAME=pro-social-ai-postgres-1
API_CONTAINER_NAME=pro-social-ai-api-1
FRONTEND_CONTAINER_NAME=auto-post-gen-frontend

# --- Volumes ----------------------------------------------------------------
# Check `docker volume ls` FIRST. If these volumes already exist and hold the
# live database and media, set VOLUMES_ARE_EXTERNAL=true so Compose adopts
# them instead of creating empty ones.
PGDATA_VOLUME=pro-social-ai_pgdata
MEDIA_VOLUME=pro-social-ai_media
VOLUMES_ARE_EXTERNAL=false

# --- Paths mounted into the frontend container ------------------------------
# Relative to deploy/, or absolute. FRONTEND_DIST_PATH is the output of
# `npm run build` on the host.
FRONTEND_DIST_PATH=../dist
NGINX_CONF_PATH=../nginx.vps.conf

# --- Public address ---------------------------------------------------------
PUBLIC_HOSTNAME=example.invalid
TRAEFIK_CERT_RESOLVER=letsencrypt
# Absolute origin, used to build the links inside outgoing emails.
APP_PUBLIC_URL=https://example.invalid
APP_NAME=Pro Social AI

# --- PostgreSQL -------------------------------------------------------------
# Never published on a port; reachable only on the internal Docker network.
POSTGRES_USER=pro_social_ai
POSTGRES_PASSWORD=replace-me-with-a-generated-password
POSTGRES_DB=pro_social_ai

# --- Sessions ---------------------------------------------------------------
# At least 32 characters or the API refuses to start. Generate one with:
#   openssl rand -hex 32
# Rotating it signs every user out; it does not invalidate their passwords.
SESSION_COOKIE_SECRET=replace-me-with-at-least-32-characters-of-random

# --- Providers (server-side only) -------------------------------------------
# Each is optional. A missing key disables exactly one capability, which the
# API reports at boot and again at the point of use — nothing fails silently.

# Editorial text. Without it, text generation is unavailable.
OPENROUTER_API_KEY=
# Optional override; ignored unless it starts with anthropic/claude-
OPENROUTER_TEXT_MODEL=

# Posters. BOTH are required together: there is no default endpoint, so an
# unset URL disables poster generation rather than sending posters to a
# third party nobody chose.
GRAPHISTE_GPT_API_KEY=
GRAPHISTE_GPT_API_URL=

# Social publishing. Without it, posts are written and scheduled but not sent.
ZERNIO_API_KEY=
ZERNIO_API_URL=

# Outbound email (password resets, trial and renewal reminders, payment
# confirmations). Without it, payments are still recorded and listed in /admin,
# but nobody is notified.
RESEND_API_KEY=
RESEND_FROM=
# Operator inbox: contact form + "nouveau paiement à vérifier" alerts.
CONTACT_TO=

# --- Subscriptions (Mobile Money) -------------------------------------------
# Public numbers shown to paying customers on /abonnement. Each is a phone
# number to transfer to, or an https:// payment link (a Wave merchant link,
# for instance). Leave unused channels empty. Changing one needs an API
# restart only — no frontend rebuild.
PAYMENT_WAVE=
PAYMENT_ORANGE_MONEY=
PAYMENT_MTN_MOMO=
PAYMENT_MOOV_MONEY=
# Account holder name shown next to those numbers (defaults to APP_NAME).
PAYMENT_BENEFICIARY=

# --- Scheduled work ---------------------------------------------------------
# Authorises POST /api/cron/publish, /api/cron/weekly and
# /api/cron/subscription-reminders, compared in constant
# time. While unset those routes answer 404 — deliberately, so that an
# unauthenticated probe cannot even confirm they exist.
CRON_SECRET=
