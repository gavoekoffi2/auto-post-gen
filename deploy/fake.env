# Fake values, for validating the compose file only. NOT a configuration.
#
#   docker compose -f deploy/docker-compose.vps.yml --env-file deploy/fake.env config
#
# Why this file is committed: `docker compose config` needs every required
# variable to be set, and the only alternative is to run it with the real
# .env.selfhosted — which prints the resolved configuration, secrets included,
# to a terminal and a scrollback. With this file the syntax, the routing, the
# volumes and the variable wiring can be checked by anyone, at any time,
# without a single real value being read or displayed.
#
# Nothing here is a credential: every value is obviously fake and the stack
# would not start with them. The real values live in .env.selfhosted on the
# VPS, which is git-ignored.

COMPOSE_PROJECT_NAME=pro-social-ai

POSTGRES_USER=fake_user
POSTGRES_PASSWORD=fake-password-not-a-secret
POSTGRES_DB=pro_social_ai

SESSION_COOKIE_SECRET=fake-session-secret-at-least-32-characters-long

PUBLIC_HOSTNAME=example.invalid
APP_PUBLIC_URL=https://example.invalid
