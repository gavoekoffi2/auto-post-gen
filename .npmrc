# Fail the install on an unsupported Node rather than at test time.
#
# The test suite imports .ts modules directly (Node strips the types), which
# needs Node >= 22.18. Without this, npm only warns, the install succeeds, and
# the first thing the developer sees is an ERR_UNKNOWN_FILE_EXTENSION from a
# test file — which reads like a broken checkout rather than a wrong runtime.
engine-strict=true
