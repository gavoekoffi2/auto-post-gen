# Frontend (Vite) — these go in .env / .env.local
VITE_SUPABASE_PROJECT_ID="your-project-id"
VITE_SUPABASE_PUBLISHABLE_KEY="your-anon-key"
VITE_SUPABASE_URL="https://your-project.supabase.co"
# Public support address shown on the contact, terms and privacy pages.
# MUST be an address you actually receive mail on: the legal pages name it as
# the contact for data-protection requests.
VITE_SUPPORT_EMAIL="contact@example.com"
# Footer social links. Set only the profiles you really own — an unset value
# hides the link rather than sending a visitor to a 404.
VITE_SOCIAL_TWITTER=""
VITE_SOCIAL_LINKEDIN=""
VITE_SOCIAL_INSTAGRAM=""

# ---------------------------------------------------------------------
# Backend secrets — DO NOT put these in .env. Set them in
# Supabase dashboard → Project Settings → Edge Functions → Secrets.
# Listed here as a checklist only.
# ---------------------------------------------------------------------

# AI generation (OpenRouter — OpenAI-compatible API). Used for the post TEXT.
# (OPENROUTER_IMAGE_MODEL is legacy — poster IMAGES go through Graphiste GPT
#  below, not OpenRouter.)
# OPENROUTER_API_KEY=sk-or-...
# OPENROUTER_TEXT_MODEL=anthropic/claude-sonnet-5  # optional Claude override; text remains Claude-only
# OPENROUTER_IMAGE_MODEL=openai/gpt-5.4-image-2
# IMAGE_GENERATION_TIMEOUT_MS=60000
# APP_NAME="Pro Social AI"
# APP_PUBLIC_URL=https://app.example.com

# Graphiste GPT: **REQUIRED for image/poster generation.** The image endpoint
# (generate-image) and the weekly cron generate posters EXCLUSIVELY through
# Graphiste GPT (premium GPT Image 2 posters) — there is NO fallback. If this
# key is missing or invalid, the app still generates the post TEXT but NEVER an
# image (the symptom: "only the text is generated"). Verify quickly with:
#   GRAPHISTE_GPT_API_KEY="..." node scripts/diagnose-graphiste.mjs
# Get the key from your Graphiste GPT account. NEVER commit the real key — set
# it in Supabase → Project Settings → Edge Functions → Secrets only.
#   GRAPHISTE_GPT_API_KEY   — required to enable image/poster generation
#   GRAPHISTE_GPT_API_URL   — optional; defaults to the documented v1.1 endpoint
# GRAPHISTE_GPT_API_KEY=
# GRAPHISTE_GPT_API_URL=https://bbfzfgcdioewzbmlgaqy.supabase.co/functions/v1/api-v1/v1/posters/generate

# Web research: works out-of-the-box for free via Google News RSS +
# DuckDuckGo HTML (no key needed). These TWO keys are OPTIONAL upgrades
# that add higher-quality sources alongside the free ones.
# TAVILY_API_KEY=
# BRAVE_SEARCH_API_KEY=

# Zernio: social API that connects + publishes to LinkedIn, Facebook and 13
# more networks via one key, with per-user isolation (Zernio "profiles").
# When present, users get a "Connexion via Zernio" option and publish-post
# routes through Zernio. Get the key at https://zernio.com/dashboard/api-keys
# (format sk_ + 64 hex). NEVER commit the real key — set it in Supabase
# Secrets only.
#   ZERNIO_API_KEY   — required to enable Zernio
#   ZERNIO_API_URL   — optional; defaults to https://zernio.com/api/v1
# ZERNIO_API_KEY=
# ZERNIO_API_URL=https://zernio.com/api/v1

# Shared secret between the Supabase Scheduler and the cron-only
# functions (auto-generate-weekly, send-validation-email, publish-post).
# CRON_SECRET=

# CORS / public URL
# ALLOWED_ORIGINS=https://app.example.com
# APP_BASE_URL=https://app.example.com

# Email (Resend)
# RESEND_API_KEY=
# RESEND_FROM="Pro Social AI <no-reply@example.com>"
# Where the public contact form (send-contact) delivers messages.
# Defaults to the RESEND_FROM address when unset.
# CONTACT_TO=support@example.com

# ---------------------------------------------------------------------
# Removed on purpose — do NOT re-add without also restoring the code.
# Publishing is Zernio-only. The Ayrshare, Postiz and direct per-platform
# OAuth (LinkedIn / Meta / Twitter) endpoints were deleted, so
# AYRSHARE_API_KEY, POSTIZ_API_KEY, OAUTH_LINKEDIN_*, OAUTH_META_* and
# OAUTH_TWITTER_* are no longer read by anything. Delete them from the
# Supabase secrets: an unused credential is only a liability.
# ---------------------------------------------------------------------
