# ---------------------------------------------------------------------
# Frontend (Vite)
# ---------------------------------------------------------------------
# NONE. The dashboard talks to the API over same-origin "/api/..." paths
# proxied by nginx, so there is no build-time configuration and no value
# about the backend baked into the bundle. `npm run build` needs no env.
#
# This is deliberate: a frontend that needs no secret cannot leak one.

# ---------------------------------------------------------------------
# API server (/opt/pro-social-ai/server) — names only, values live in
# .env.selfhosted on the VPS and are NEVER committed.
# ---------------------------------------------------------------------
# Every provider below is called from the API container only. None of these
# names is ever read by the frontend, and none is exposed to the browser.

# --- Core ---
# DATABASE_URL=                 # postgres://... to the local Postgres container
# SESSION_COOKIE_SECRET=        # long random value signing the session cookie
# APP_PUBLIC_URL=               # https origin, used for links in emails
# APP_NAME="Pro Social AI"
# MEDIA_ROOT=/app/media         # local volume the API stores uploads in
# NODE_ENV=production

# --- AI text (server-side only) ---
# OPENROUTER_API_KEY=
# OPENROUTER_TEXT_MODEL=        # optional Claude override; text stays Claude-only

# --- AI posters (server-side only) ---
# GRAPHISTE_GPT_API_KEY=        # without it: text generates, posters do NOT
# GRAPHISTE_GPT_API_URL=        # optional override of the default endpoint

# --- Social publishing ---
# ZERNIO_API_KEY=
# ZERNIO_API_URL=

# --- Transactional email (password reset, post validation, contact form) ---
# RESEND_API_KEY=
# RESEND_FROM="Pro Social AI <no-reply@your-verified-domain>"
# CONTACT_TO=                   # where the contact form delivers

# --- Scheduled jobs ---
# CRON_SECRET=                  # shared secret for the scheduler endpoints

# --- Optional web research upgrades (free sources work without these) ---
# TAVILY_API_KEY=
# BRAVE_SEARCH_API_KEY=
